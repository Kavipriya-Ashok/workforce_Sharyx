# Copy to .env.local (git-ignored) and fill in. Vite only exposes variables that start with VITE_.
# Google OAuth *client id* (public value, same one as GOOGLE_CLIENT_ID in backend/.env.local).
# If it is empty the "Continue with Google" button shows a friendly "not configured" message.
VITE_GOOGLE_CLIENT_ID=
# Dev only: backend that the Vite dev server proxies /api to (default http://localhost:8000)
# VITE_API_TARGET=http://localhost:8000
